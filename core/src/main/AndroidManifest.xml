<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- FCM direct sends target the Firebase Installation ID. This opt-in
             registers that FID with the messaging backend. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <service
            android:name=".fcm.HeraldMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.browser.customtabs.PostMessageService"
            android:exported="true" />

        <!-- LauncherActivity toggles this component on every TWA launch to
             publish the site settings shortcut; undeclared, launch crashes. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false" />
    </application>
</manifest>
